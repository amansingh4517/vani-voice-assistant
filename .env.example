# Vani runs 100% locally and requires no API keys.
# Primary assistant configuration lives in src/vani/config.py.
# Optional environment variables recognized by underlying libraries:

# Custom Ollama server URL (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Hugging Face cache directory for MLX Whisper / Kokoro models
# HF_HOME=~/.cache/huggingface
